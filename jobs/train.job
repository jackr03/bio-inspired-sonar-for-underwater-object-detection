#!/bin/bash

#SBATCH --partition=gpuL
#SBATCH --gpus=1
#SBATCH -c 8
#SBATCH --ntasks=1
#SBATCH --time=1-0

# Usage: sbatch train.job <model> <dataset> <filterbank>
set -euo pipefail

MODEL="${1:?Usage: sbatch train.job <model> <dataset> <filterbank>}"
DATASET="${2:?Usage: sbatch train.job <model> <dataset> <filterbank>}"
FILTERBANK="${3:?Usage: sbatch train.job <model> <dataset> <filterbank>}"

module load apps/binapps/conda/miniforge3/25.9.1
module load libs/cuda/12.4.1

BASE="/mnt/iusers01/fse-ugpgt01/compsci01/x06213zr/scratch/bio-inspired-sonar-for-underwater-object-detection"
RUN_DIR="$BASE/runs/${MODEL}-${DATASET}-${FILTERBANK}_$(date +%Y-%m-%d_%H-%M)"
mkdir -p "$RUN_DIR"

exec > >(tee -a "$RUN_DIR/output.log") 2>&1

echo "===== Job started at $(date) ====="
echo "RUN_ID: $SLURM_JOB_ID"
echo "MODEL: $MODEL | DATASET: $DATASET | FILTERBANK: $FILTERBANK"

echo "Installing requirements..."
cd $BASE
python -m venv .venv
source ./.venv/bin/activate
pip install --quiet -r "$BASE/requirements/requirements-cuda.txt"

echo "Temporarily copying processed data to temporary directory..."
if [[ "$MODEL" == "snn" ]]; then
    TAR_NAME="${DATASET}-${FILTERBANK}-spikes"
else
    TAR_NAME="${DATASET}-${FILTERBANK}-spectrograms"
fi
tar xf "$BASE/processed/${TAR_NAME}.tar" -C "$TMPDIR/"
export PROCESSED_DATA_DIR="$TMPDIR"

echo "===== Training started at $(date) ====="
CUDA_VISIBLE_DEVICES=0 python -u -m src.run_train --model "$MODEL" --dataset "$DATASET" --filterbank "$FILTERBANK" --run-dir "$RUN_DIR"
echo "===== Training finished at $(date) ====="